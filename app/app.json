{
  "expo": {
    "name": "SlopeInsights",
    "slug": "slopeinsights",
    "version": "1.0.0",
    "scheme": "slopeinsights",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.slopeinsights.app",
      "supportsTablet": false,
      "iap": {
        "products": [
          "com.slopeinsights.app.fullaccess"
        ]
      }
    },
    "android": {
      "package": "com.slopeinsights.app",
      "adaptiveIcon": {
        "backgroundColor": "#1d4ed8"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-system-ui",
        {
          "userInterfaceStyle": "light"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
