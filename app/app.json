{
  "expo": {
    "name": "SlopeInsights",
    "slug": "slopeinsights",
    "version": "1.0.0",
    "scheme": "slopeinsights",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.slopeinsights.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.slopeinsights.app",
      "adaptiveIcon": {
        "backgroundColor": "#1d4ed8"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-system-ui",
        {
          "userInterfaceStyle": "light"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc8302d3-34a6-4223-8cc2-ccf27fb21248"
      }
    },
    "owner": "swansonsites-llc"
  }
}
