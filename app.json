{
  "expo": {
    "name": "PowderPass",
    "slug": "powderpass",
    "version": "1.0.0",
    "scheme": "powderpass",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.yourcompany.powderpass",
      "supportsTablet": false,
      "iap": {
        "products": ["com.yourcompany.powderpass.fullaccess"]
      }
    },
    "android": {
      "package": "com.yourcompany.powderpass",
      "adaptiveIcon": {
        "backgroundColor": "#1d4ed8"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      ["expo-system-ui", { "userInterfaceStyle": "light" }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
