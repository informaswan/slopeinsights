# Local dev: leave DATABASE_URL unset to use the default sqlite:///./slopeinsights.db
# Production (Lightsail): point at the persistent volume mounted by docker-compose.yml
DATABASE_URL=sqlite:////data/slopeinsights.db
API_KEY=change-me-before-deploying
JWT_SECRET=change-me-generate-a-real-random-secret
ENVIRONMENT=production
CORS_ORIGINS=https://slopeinsights.com,https://www.slopeinsights.com

# Optional: email a copy of each feedback submission (feedback is always saved to the DB).
# Gmail: create an app password (Google Account > Security > 2-Step Verification > App passwords).
# Several recipients: comma-separated (FEEDBACK_TO_EMAIL=me@gmail.com,brother@gmail.com)
FEEDBACK_TO_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@example.com
